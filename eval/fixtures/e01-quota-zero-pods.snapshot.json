      {
       "command": [
        "sh",
        "-c",
        "set -e\ncp /ca-in/roots.pem /bbt-certs/bbt-root-ca.crt\nchmod 644 /bbt-certs/bbt-root-ca.crt\n\n# Try to ensure system CA certificates are present for common distros\nif command -v apt-get >/dev/null 2>&1; then\n    timeout 20 apt-get update >/dev/null 2>&1 && timeout 20 apt-get install -y ca-certificates >/dev/null 2>&1 || true\nelif command -v apk >/dev/null 2>&1; then\n    timeout 20 apk add --no-cache ca-certificates >/dev/null 2>&1 || true\nelif command -v dnf >/dev/null 2>&1; then\n    timeout 20 dnf install -y ca-certificates >/dev/null 2>&1 || true\nelif command -v yum >/dev/null 2>&1; then\n    timeout 20 yum install -y ca-certificates >/dev/null 2>&1 || true\nfi\n\nif [ -f /etc/ssl/certs/ca-certificates.crt ]; then\n    cp /etc/ssl/certs/ca-certificates.crt /bbt-certs/ca-bundle.crt\nelif [ -f /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem ]; then\n    cp /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /bbt-certs/ca-bundle.crt\nelse\n    cp /bbt-certs/bbt-root-ca.crt /bbt-certs/ca-bundle.crt\nfi\ncat /bbt-certs/bbt-root-ca.crt >> /bbt-certs/ca-bundle.crt\n\n# Generate Java truststore if keytool is available\nif command -v keytool >/dev/null 2>&1 && [ -f /bbt-certs/bbt-root-ca.crt ]; then\n    for cacerts_path in /etc/ssl/certs/java/cacerts /usr/lib/jvm/default-jvm/lib/security/cacerts /usr/lib/jvm/*/lib/security/cacerts /opt/java/*/lib/security/cacerts /opt/*/lib/security/cacerts; do\n        if [ -f \"$cacerts_path\" ]; then\n            cp \"$cacerts_path\" /bbt-certs/java-cacerts\n            keytool -importcert -keystore /bbt-certs/java-cacerts -storepass changeit -alias bbt-root-ca -file /bbt-certs/bbt-root-ca.crt -noprompt >/dev/null 2>&1 || true\n            break\n        fi\n    done\nfi\n"
       ],
